diff --git a/transports/bifrost-http/server/plugins.go b/transports/bifrost-http/server/plugins.go
index b22c726..caef526 100644
--- a/transports/bifrost-http/server/plugins.go
+++ b/transports/bifrost-http/server/plugins.go
@@ -8,6 +8,7 @@ import (
 
 	"github.com/maximhq/bifrost/core/schemas"
 	"github.com/maximhq/bifrost/plugins/compat"
+	"github.com/maximhq/bifrost/plugins/credits"
 	"github.com/maximhq/bifrost/plugins/governance"
 	"github.com/maximhq/bifrost/plugins/logging"
 	"github.com/maximhq/bifrost/plugins/modelcatalogresolver"
@@ -195,6 +196,15 @@ func loadBuiltinPlugin(ctx context.Context, name string, pluginConfig any, bifro
 	case modelcatalogresolver.PluginName:
 		return modelcatalogresolver.Init(bifrostConfig.ModelCatalog, logger)
 
+	case credits.PluginName:
+		creditsConfig, err := MarshalPluginConfig[credits.Config](pluginConfig)
+		if err != nil {
+			// A plugin that returns an error here is logged and skipped, and the gateway would
+			// then serve without charging. One that cannot be configured refuses every request.
+			return credits.Refusing(err.Error(), logger), nil
+		}
+		return credits.Init(ctx, creditsConfig, logger, bifrostConfig.ModelCatalog)
+
 	default:
 		return nil, fmt.Errorf("unknown built-in plugin: %s", name)
 	}
